{
  "name": "@yaguhae/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "prettier": "@yaguhae/prettier-config",
  "devDependencies": {
    "@yaguhae/prettier-config": "workspace:*",
    "@yaguhae/typescript-config": "workspace:*",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
